  │   │   ├── components/   # переиспользуемые UI-компоненты
  │   │   ├── features/     # функционал по разделам меню
  │   │   └── api/          # клиент к backend
  │   └── package.json
  ├── docker-compose.yml    # postgres + backend + frontend (локальная отладка)
