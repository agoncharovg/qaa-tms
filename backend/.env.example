# Bootstrap-only backend settings. These stay outside Profile -> Settings.
DATABASE_URL=postgresql+asyncpg://qaa_tms:qaa_tms@localhost:5432/qaa_tms
JWT_SECRET=dev-secret-change-me
JWT_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Operational backend settings editable at Profile -> Settings -> Server.
# The browser never receives these tokens.
QAA_GENERATOR_BASE_URL=https://qaa-generator-prod.i.gc.onl/api/v1
# QAA generator admin routes require a separate superuser token. If this stays
# empty, /api/v1/qaa/admin/* returns 501 and the SPA shows the admin tab but
# cannot perform upstream admin actions.
QAA_GENERATOR_SUPERUSER_TOKEN=
# Plaintext QAA generator user and service tokens are shown once in the SPA copy modal and are
# never persisted or written to the operations audit.

# Shared Jenkins read-only credentials for backend-side tree/builds/folder/scope fills.
# Leave USERNAME/TOKEN empty to disable server-side Jenkins reads. Do NOT reuse these
# credentials for freeze/resume or any Jenkins write path.
JENKINS_COMMON_URL=https://jenkins.p.gc.onl
JENKINS_COMMON_USERNAME=
JENKINS_COMMON_TOKEN=
# Shared Jenkins read-only scope served by GET /api/v1/jenkins/scope.
JENKINS_ROOT_GROUPS=BE=job/.QAA/job/E2E,FE=job/.QAA/job/UI_E2E
JENKINS_ROOT_FOLDERS=PREPROD,PROD
JENKINS_TREE_DEPTH=5
JENKINS_HISTORY_LIMIT=8
JENKINS_REQUEST_TIMEOUT=15
