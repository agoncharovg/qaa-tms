DATABASE_URL=postgresql+asyncpg://qaa_tms:qaa_tms@localhost:5432/qaa_tms
JWT_SECRET=dev-secret-change-me
JWT_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# qaa-generator run proxy settings. The browser never receives these tokens.
QAA_GENERATOR_BASE_URL=http://qaa-generator.default.svc.cluster.local:8080/api/v1
QAA_GENERATOR_SERVICE_TOKEN=
# qaa-generator admin routes require a separate superuser token. If this stays
# empty, /api/v1/qaa/admin/* returns 501 and the SPA shows the admin tab but
# cannot perform upstream admin actions.
QAA_GENERATOR_SUPERUSER_TOKEN=
# Plaintext qaa-generator tokens are shown once in the SPA copy modal and are
# never persisted or written to the operations audit.
QAA_GENERATOR_ACTOR=
