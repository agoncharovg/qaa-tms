#!/usr/bin/env bash
set -euo pipefail

BACKEND_ORIGIN="__BACKEND_ORIGIN__"

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "Missing required command: $1" >&2
    exit 1
  fi
}

require_command curl
require_command tar
require_command python3

manifest=$(curl -fsSL "${BACKEND_ORIGIN}/api/v1/agent/manifest")
download_url=$(
  printf '%s' "$manifest" | python3 -c 'import json, sys; manifest = json.load(sys.stdin); print(manifest["downloadUrl"])'
)
expected_sha256=$(
  printf '%s' "$manifest" | python3 -c 'import json, sys; manifest = json.load(sys.stdin); print(manifest["sha256"])'
)

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

archive_path="$tmp/agent.tar.gz"
curl -fsSL "${BACKEND_ORIGIN}${download_url}" -o "$archive_path"

actual_sha256=$(
  python3 -c 'import hashlib, pathlib, sys; print(hashlib.sha256(pathlib.Path(sys.argv[1]).read_bytes()).hexdigest())' "$archive_path"
)

if [ "$actual_sha256" != "$expected_sha256" ]; then
  echo "Downloaded companion archive failed sha256 verification." >&2
  echo "Expected: $expected_sha256" >&2
  echo "Actual:   $actual_sha256" >&2
  exit 1
fi

tar -xzf "$archive_path" -C "$tmp"

if [ ! -t 0 ] && [ ! -e /dev/tty ]; then
  echo "The companion installer needs an interactive terminal." >&2
  exit 1
fi

# Delegate to the bundled install.sh --backend-url installer with terminal input.
chmod +x "$tmp/agent/install.sh"
"$tmp/agent/install.sh" --backend-url "${BACKEND_ORIGIN}" < /dev/tty

# --- Verify: the portal only re-checks on reload, so confirm the companion is
# --- actually running AND reachable with the origin the browser will send.
AGENT_PORT="${QAA_TMS_AGENT_PORT:-47600}"
PING_URL="http://127.0.0.1:${AGENT_PORT}/ping"

echo "Waiting for the companion to answer on ${PING_URL} ..."
deadline=$(( $(date +%s) + 30 ))
until curl -fsS "$PING_URL" >/dev/null 2>&1; do
  if [ "$(date +%s)" -ge "$deadline" ]; then
    echo "The companion did not start within 30s." >&2
    echo "Check its logs: journalctl --user -u qaa-tms-agent.service -e" >&2
    exit 1
  fi
  sleep 1
done
echo "Companion is running: $(curl -fsS "$PING_URL")"

# Replay the browser's cross-origin preflight to catch an http/https origin mismatch.
allowed_origin=$(
  curl -s -o /dev/null -D - -X OPTIONS "$PING_URL" \
    -H "Origin: ${BACKEND_ORIGIN}" \
    -H "Access-Control-Request-Method: GET" \
    -H "Access-Control-Request-Headers: x-qaa-tms" \
    | tr -d '\r' \
    | awk -F': ' 'tolower($1) == "access-control-allow-origin" { print $2 }'
)

if [ "$allowed_origin" != "${BACKEND_ORIGIN}" ]; then
  echo "The companion is running but rejects the portal origin ${BACKEND_ORIGIN} (CORS)." >&2
  echo "Allowed-Origin header was: '${allowed_origin:-<none>}'." >&2
  echo "Fix: set AGENT_CORS_ORIGINS=${BACKEND_ORIGIN} in \${QAA_TMS_HOME:-\$HOME/.qaa-tms}/.env" >&2
  echo "then run: systemctl --user restart qaa-tms-agent.service" >&2
  exit 1
fi

echo "✓ Companion installed, running, and reachable from ${BACKEND_ORIGIN}. Reload the portal (F5)."
