# Bootstrap-only companion settings. These stay outside Profile -> Settings.
AGENT_HOST=127.0.0.1
AGENT_PORT=47600
AGENT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AGENT_BACKEND_URL=http://localhost:8000
# Operational companion settings editable at Profile -> Settings -> Local companion.
# Base Notificator URL used by the read-only notifications plugin. Requires local VPN/SSO reachability.
AGENT_NOTIFICATOR_URL=https://notificator-prod.i.gc.onl
# Shared Notificator API token attached by the companion on every read request.
AGENT_NOTIFICATOR_TOKEN=
# Base Jenkins URL used by the Jenkins explorer plugin. Requires local VPN access.
AGENT_JENKINS_URL=https://jenkins.p.gc.onl
# Your personal Jenkins username. The companion app uses your own access only.
AGENT_JENKINS_USERNAME=
# Your personal Jenkins API token. Never share a team token here.
AGENT_JENKINS_TOKEN=
# Your personal QAA generator token used for Generate/Live/Runs via the local companion.
AGENT_QAA_GENERATOR_TOKEN=
# Grouped Jenkins source roots shared by the env folders below.
AGENT_JENKINS_ROOT_GROUPS=BE=job/.QAA/job/E2E,FE=job/.QAA/job/UI_E2E
# Editable allow-list of env folders shared across every configured root group. Default: PREPROD,PROD.
AGENT_JENKINS_ROOT_FOLDERS=PREPROD,PROD
# Folded build-history strip size embedded into the tree response.
AGENT_JENKINS_HISTORY_LIMIT=8
# Optional timeout for Jenkins API reads, in seconds.
AGENT_JENKINS_REQUEST_TIMEOUT=15
# Recursive Jenkins jobs depth for the single tree fetch.
AGENT_JENKINS_TREE_DEPTH=5
# Idle hours before an unscheduled buildable pipeline is treated as STUCK.
AGENT_JENKINS_STUCK_MIN_IDLE_HOURS=6
# Pause between throttled Jenkins resume starts, in seconds.
AGENT_JENKINS_RESUME_PAUSE_SECONDS=1.0
AGENT_STAGING_BIN=
AGENT_STAGINGS_REPO=
# Staging kubeconfig path used by Stagings preflight and kubeconfig refresh.
STAGING_KUBECONFIG=~/.kube/ai-staging.yaml
# Download URL for refreshing the staging kubeconfig. Requires Full VPN.
AGENT_STAGING_KUBECONFIG_URL=https://kubeconf.frn-stg.p.gc.onl/config
# Managed active kubeconfig symlink. If you already use qaa kuber, point this at the same symlink path,
# for example ~/.kube/kubecfg.yaml, so the agent never tries to replace a real ~/.kube/config file.
AGENT_KUBECONFIG_ACTIVE_PATH=~/.kube/config
# Maximum accepted staging kubeconfig age in hours before the banner warns and refresh is recommended.
AGENT_STAGING_KUBECONFIG_MAX_AGE_HOURS=48
# Optional explicit path to kubectl. Leave empty to use PATH lookup.
AGENT_KUBECTL_BIN=kubectl
# Optional explicit kubeconfig override for kubectl subprocesses. Leave empty to inherit ambient kubeconfig
# resolution (the KUBECONFIG env and/or ~/.kube/config), merged with the active-path symlink.
AGENT_KUBECONFIG=
# Optional timeout added to non-streaming kubectl read commands.
AGENT_KUBECTL_REQUEST_TIMEOUT=10s
