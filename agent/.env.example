AGENT_HOST=127.0.0.1
AGENT_PORT=47600
AGENT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AGENT_BACKEND_URL=http://localhost:8000
AGENT_STAGING_BIN=
AGENT_STAGINGS_REPO=
# Staging kubeconfig path used by Stagings preflight and kubeconfig refresh.
STAGING_KUBECONFIG=~/.kube/ai-staging.yaml
# Download URL for refreshing the staging kubeconfig. Requires Full VPN.
AGENT_STAGING_KUBECONFIG_URL=https://kubeconf.frn-stg.p.gc.onl/config
# Managed active kubeconfig symlink. If you already use qaa kuber, point this at the same symlink path,
# for example ~/.kube/kubecfg.yaml, so the agent never tries to replace a real ~/.kube/config file.
AGENT_KUBECONFIG_ACTIVE_PATH=~/.kube/config
# Maximum accepted staging kubeconfig age in hours before the banner warns and refresh is recommended.
AGENT_STAGING_KUBECONFIG_MAX_AGE_HOURS=48
# Optional explicit path to kubectl. Leave empty to use PATH lookup.
AGENT_KUBECTL_BIN=kubectl
# Optional kubeconfig override for kubectl subprocesses. Leave empty to inherit ambient kubeconfig resolution.
AGENT_KUBECONFIG=
# Optional timeout added to non-streaming kubectl read commands.
AGENT_KUBECTL_REQUEST_TIMEOUT=10s
