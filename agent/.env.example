AGENT_HOST=127.0.0.1
AGENT_PORT=47600
AGENT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AGENT_BACKEND_URL=http://localhost:8000
AGENT_STAGING_BIN=
AGENT_STAGINGS_REPO=
# Optional explicit path to kubectl. Leave empty to use PATH lookup.
AGENT_KUBECTL_BIN=kubectl
# Optional kubeconfig override for kubectl subprocesses. Leave empty to inherit ambient kubeconfig resolution.
AGENT_KUBECONFIG=
# Optional timeout added to non-streaming kubectl read commands.
AGENT_KUBECTL_REQUEST_TIMEOUT=10s
